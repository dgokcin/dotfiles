{
  "files.trimTrailingWhitespace": true,
  "sync.quietSync": true,
  "sync.autoDownload": false,
  "redhat.telemetry.enabled": false,
  "[go]": {
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "golang.go",
  },
  "[yaml]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.formatOnSave": true,
    "gitlens.codeLens.scopes": ["document"],
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[yml]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.formatOnSave": true,
    "gitlens.codeLens.scopes": ["document"],
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.tabSize": 2,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
  },
  "[terraform-vars]": {
    "editor.defaultFormatter": "fredwangwang.vscode-hcl-format",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
  },
  "[tf]": {
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.defaultFormatter": "fredwangwang.vscode-hcl-format",
    "editor.formatOnSaveMode": "file",
  },
  "[terragrunt]": {
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.defaultFormatter": "fredwangwang.vscode-hcl-format",
    "editor.formatOnSaveMode": "file",
  },
  "[hcl]": {
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.defaultFormatter": "fredwangwang.vscode-hcl-format",
    "editor.formatOnSaveMode": "file",
  },
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true,
    },
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "git.autofetch": true,
  "editor.fontFamily": "'Monaspace Neon', monospace",
  "security.workspace.trust.untrustedFiles": "open",
  "editor.inlineSuggest.enabled": true,
  "github.copilot.enable": {
    "*": false,
    "plaintext": true,
    "markdown": true,
    "scminput": false,
    "yaml": true,
  },
  "yaml.customTags": [
    "!And",
    "!And sequence",
    "!If",
    "!If sequence",
    "!Not",
    "!Not sequence",
    "!Equals",
    "!Equals sequence",
    "!Or",
    "!Or sequence",
    "!FindInMap",
    "!FindInMap sequence",
    "!Base64",
    "!Join",
    "!Join sequence",
    "!Cidr",
    "!Ref",
    "!Sub",
    "!Sub sequence",
    "!GetAtt",
    "!GetAZs",
    "!ImportValue",
    "!ImportValue sequence",
    "!Select",
    "!Select sequence",
    "!Split",
    "!Split sequence",
  ],
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
  },
  "vsicons.dontShowNewVersionMessage": true,
  "workbench.editor.wrapTabs": true,
  "workbench.editor.openPositioning": "last",
  "explorer.confirmDelete": false,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.suggest.showMethods": true,
  "editor.suggest.preview": true,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.snippetSuggestions": "top",
  "git.mergeEditor": true,
  "merge-conflict.autoNavigateNextConflict.enabled": true,
  "merge-conflict.diffViewPosition": "Beside",
  "githubPullRequests.pullBranch": "never",
  "aws.suppressPrompts": {
    "ecsRunCommand": true,
  },
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "\\.hcl$",
        "cmd": "terragrunt hclfmt --terragrunt-hclfmt-file ${file}",
      },
    ],
  },
  "aws.samcli.enableCodeLenses": true,
  "hediet.vscode-drawio.theme": "atlas",
  "editor.hover.enabled": true,
  "codestream.serverUrl": "https://api.codestream.com",
  "codestream.email": "dgokcin@gmail.com",
  "[python]": {
    "editor.formatOnType": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
  },
  "omnisharp.autoStart": false,
  "csharp.showOmnisharpLogOnError": false,
  "roslynator.autoUpdateOmnisharpJson": false,
  "local-history.path": "~/.code_history",
  "projectManager.git.baseFolders": ["~/codes"],
  "vim.normalModeKeyBindings": [
    {
      "before": [":", "w", "enter"],
      "commands": ["editor.action.formatDocument"],
      "silent": true,
    },
    {
      "before": [":", "W", "enter"],
      "commands": ["editor.action.formatDocument"],
      "silent": true,
    },
  ],
  "aws.codeWhisperer.importRecommendation": false,
  "aws.codeWhisperer.includeSuggestionsWithCodeReferences": false,
  "git.openRepositoryInParentFolders": "never",
  "go.formatTool": "gofmt",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "quickfix.biome": "explicit",
      "source.organizeImports.biome": "explicit",
    },
  },
  "genieai.enableConversationHistory": true,
  "genieai.openai.organization": "org-LWRfAnksEXZn8aEU0HUfu7Ez",
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "hediet.vscode-drawio.resizeImages": null,
  "[github-actions-workflow]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.formatOnSave": true,
    "gitlens.codeLens.scopes": ["document"],
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "projectManager.git.maxDepthRecursion": 1,
  "go.toolsManagement.autoUpdate": true,
  "editor.accessibilitySupport": "off",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "peacock.surpriseMeOnStartup": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.fontFamily": "Menlo, Monaco, 'Hack Nerd Font Mono', monospace",
  "cloudcode.duetAI.project": "duet-408219",
  "cloudcode.duetAI.inlineSuggestions.enableAuto": false,
  "terminal.integrated.env.osx": {
    "CW_NEW_SESSION": "1",
  },
  "gitlens.ai.experimental.provider": "openai",
  "gitlens.ai.experimental.openai.model": "gpt-4",
  "git.ignoreSubmodules": true,
  "git.detectSubmodulesLimit": 1,
  "accessibility.signals.terminalBell": {
    "announcement": "off",
    "sound": "off",
  },
  "workbench.startupEditor": "none",
  "accessibility.voice.keywordActivation": "chatInView",
  "cursor.cpp.disabledLanguages": ["scminput"],
  "aws.telemetry": false,
  "oneDarkPro.vivid": true,
  "editor.wordWrap": "on",
  "[lua]": {
    "editor.defaultFormatter": "sumneko.lua",
  },
  "Lua.diagnostics.globals": ["vim"],
  "amazonQ.shareContentWithAWS": false,
  "amazonQ.telemetry": false,
  "csharp.debug.logging.diagnosticsLog.dispatcherMessages": "normal",
  "omnisharp.loggingLevel": "trace",
  "dotnet.server.trace": "Trace",
  "razor.server.trace": "Trace",
  "amazonQ.showInlineCodeSuggestionsWithCodeReferences": false,
  "amazonQ.importRecommendationForInlineCodeSuggestions": false,
  "sync.autoUpload": true,
  "workbench.activityBar.orientation": "vertical",
  "github.copilot.editor.enableCodeActions": false,
  "github.copilot.editor.enableAutoCompletions": false,
  "extensions.ignoreRecommendations": true,
  "debug.onTaskErrors": "debugAnyway",
  "workbench.editorAssociations": {
    "*.mdc": "default",
