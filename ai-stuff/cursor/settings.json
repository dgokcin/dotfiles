  "workbench.iconTheme": "vscode-icons",
  "workbench.colorTheme": "Default Dark Modern",
  "cursorStats.enableStatusBarColors": false,
  "explorer.confirmDragAndDrop": false,
  "update.releaseTrack": "dev",
  "debug.javascript.autoAttachFilter": "smart",
  "docker.extension.enableComposeLanguageServer": false,
  "datadog.general.datadogMenu.showLabels": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,
  "cursor.agent_layout_browser_beta_setting": true,
  "datadog.connection.oauth.setup.domain": "app.datadoghq.eu",
  "vs-kubernetes": {
    "vscode-kubernetes.kubectl-path-mac": "/Users/denizgokcin/.vs-kubernetes/tools/kubectl/kubectl",
    "vscode-kubernetes.minikube-path-mac": "/Users/denizgokcin/.vs-kubernetes/tools/minikube/darwin-arm64/minikube",
    "vscode-kubernetes.helm-path-mac": "/Users/denizgokcin/.vs-kubernetes/tools/helm/darwin-arm64/helm",
  },
  "files.autoSave": "afterDelay",
  "cursor.composer.usageSummaryDisplay": "always",
  "playwright.showTrace": false,
  "playwright.reuseBrowser": false,
  "git.blame.editorDecoration.enabled": true,
  "gitlens.currentLine.enabled": false,
  "claudeCode.preferredLocation": "sidebar",
  "python.defaultInterpreterPath": "/usr/local/bin/python3",
  "update.mode": "silentlyApplyOnQuit",
  "datadog.codeSecurity.notification.suppressOnboarding": true,
  "datadog.cursor.notification.suppressMcpMigrationMessage": true,
  "gitlab.duoAgentPlatform.enabled": false,
  "window.autoDetectColorScheme": false,
  "claudeCode.useTerminal": true,
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
