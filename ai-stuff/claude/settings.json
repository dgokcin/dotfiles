{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/scripts/file-suggestion.sh"
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "95",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1",
    "CLODEX_PLAN_USD": "10",
    "CLODEX_SPEND_WINDOW_DAYS": "30",
    "ENABLE_LSP_TOOL": "1",
    "ENABLE_TOOL_SEARCH": "auto:0.2"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:docs.datadoghq.com)",
      "Read(~/codes/work/**)",
      "Read(~/.config/ai-shared/**)",
      "Read(~/vault/personal/nl/house search/buying a house/**)",
      "Read(~/Library/Application Support/Dia/User Data/Profile 1/AgentServer/contexts/**)",
      "WebSearch",
      "Skill(daily-recap)",
      "Bash(obsidian *)",
      "Bash(npm run lint)",
      "Bash(npm run test *)",
      "Bash(git show *)",
      "Bash(git log *)",
      "Bash(glab mr view *)",
      "Bash(glab mr diff *)",
      "Bash(glab mr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rtk npm run lint)",
      "Bash(rtk npm run test *)",
      "Bash(rtk git show *)",
      "Bash(rtk git log *)",
      "Bash(rtk glab mr view *)",
      "Bash(rtk glab mr diff *)",
      "Bash(rtk glab mr list *)",
      "Bash(rtk gh pr view *)",
      "Bash(rtk gh pr diff *)",
      "Bash(rtk gh pr list *)",
      "Bash(rtk find:*)",
      "Bash(rtk head:*)",
      "Bash(rtk ls:*)",
      "Bash(rtk grep:*)",
      "Bash(rtk read:*)",
      "SendMessage"
    ],
    "defaultMode": "auto"
  },
  "enableAllProjectMcpServers": false,
  "skillOverrides": {
    "buddy": "off",
    "commit": "off",
    "dev-story": "off",
    "jiragirl": "off",
    "mega-dev": "off",
    "spike": "off"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/auto-approve-tools.sh permission"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$NVIM\" ] && nvim --server \"$NVIM\" --remote-expr 'execute(\"checktime\")' > /dev/null 2>&1 || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/auto-approve-tools.sh pre-tool"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Working directory: $(git rev-parse --show-toplevel 2>/dev/null || pwd)\nMain git dir: $(git rev-parse --git-common-dir 2>/dev/null)\nIs worktree: $(git rev-parse --is-inside-work-tree 2>/dev/null)\nMain worktree: $(git worktree list --porcelain 2>/dev/null | head -1 | sed 's/worktree //')\"",
            "statusMessage": "Checking git worktree context"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/session-start.sh",
            "statusMessage": "Auto-naming worktree session"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/worktree-create.sh"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/worktree-remove.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableArtifact": false,
  "enableWorkflows": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh",
    "refreshInterval": 60
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "~/.claude/scripts/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": false,
    "datadog@treatwell": true,
    "feature-dev@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "ponytail@ponytail": false,
    "pyright-lsp@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "pokemon@claude-pokemon": true
  },
  "extraKnownMarketplaces": {
    "agent-plugins-for-aws": {
      "source": {
        "source": "github",
        "repo": "awslabs/agent-plugins"
      },
      "autoUpdate": true
    },
    "claude-pokemon": {
      "source": {
        "source": "directory",
        "path": "/Users/deniz.gokcin/codes/claude-pokemon"
      }
    },
    "developer-kit": {
      "source": {
        "source": "github",
        "repo": "giuseppe-trisciuoglio/developer-kit"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "treatwell": {
      "source": {
        "source": "directory",
        "path": "$HOME/codes/work/claude-skills"
      }
    }
  },
  "outputStyle": "Declaude",
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "modelSettings": {
    "astra": {
      "effortLevel": "high"
    },
    "claude-fable-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "deepseek-v4-pro": {
      "effortLevel": "xhigh"
    },
    "luna": {
      "effortLevel": "low"
    },
    "sol": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": false,
  "pluginConfigs": {
    "gitops@treatwell": {
      "options": {
        "clustersJsonPath": "/Users/denizgokcin/codes/dotfiles/ai-stuff/_shared/config/.clusters.json",
        "ownerTeam": "platform-devx"
      }
    },
    "session-handover@treatwell": {
      "options": {
        "obsidian_vault_path": "/Users/denizgokcin/Library/Mobile Documents/iCloud~md~obsidian/Documents/vault"
      }
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "iterm2_with_bell",
  "teammateMode": "iterm2",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
